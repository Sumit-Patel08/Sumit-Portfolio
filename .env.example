# Email notification for the contact form (https://resend.com)
RESEND_API_KEY=REDACTED
# Optional: where contact messages are emailed. Defaults to the address in contact.functions.ts
CONTACT_NOTIFY_TO=you@example.com

# Firebase service account for archiving contact messages in Cloud Firestore.
# Option A: paste the whole service account JSON on ONE line, in single quotes.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"}'
# Option B: set the three values individually instead (keep the \n escapes in the key).
# FIREBASE_PROJECT_ID=your-project
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional: Firestore collection name. Defaults to contactMessages
# FIREBASE_CONTACT_COLLECTION=contactMessages
